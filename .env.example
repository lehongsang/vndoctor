# Application
APP_NAME=VNDoctor Backend
APP_PORT=3456
NODE_ENV=production
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_FILE_MAX_SIZE_MB=50
LOG_FILE_RETENTION_DAYS=14
FRONTEND_URL=http://localhost:5173

# PostgreSQL
# - POSTGRES_HOST: host used when the app runs outside Docker.
# - POSTGRES_HOST_PORT: host port mapped to the Postgres container.
# - POSTGRES_PORT: internal Docker network port, usually 5432.
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5434
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vndoctor-dev
POSTGRES_SSL=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_TIMEZONE=Asia/Ho_Chi_Minh

# Better Auth
BETTER_AUTH_BASE_URL=http://localhost:3456/api/auth
BETTER_AUTH_URL=http://localhost:3456/api/auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Redis
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6378
REDIS_URL=redis://:change-me-redis-password@localhost:6378

# Mail (BullMQ + SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="VNDoctor <noreply@example.com>"

# Default Admin Account (Sync on startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# S3 Storage / SeaweedFS
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_FILER_S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_EXTERNAL_URL=http://localhost:8333
S3_PUBLIC_BASE_URL=http://localhost:8333/medias
S3_REGION=us-east-1
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=medias
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRES_IN_SECONDS=201600

# Container Log Viewer
DOZZLE_PORT=9999
